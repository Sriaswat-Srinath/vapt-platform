# VAPT — example environment. Copy to .env and fill in. NEVER commit .env.
# .gitignore excludes .env and .env.* (except this file).

# ---- M1 lab topology -------------------------------------------------------
LAB_NETWORK_NAME=vapt_lab
LAB_SUBNET=172.30.10.0/24
ZAP_IP=172.30.10.10
JUICESHOP_IP=172.30.10.20
# Clients permitted to call the ZAP API, as a ZAP api.addrs regex.
# .30-.39 is the worker range (M2+). The bridge gateway (.1, i.e. the host) is
# deliberately NOT in this range: see docs/SAFETY.md and ADR-0008 R3 §9.
ZAP_API_CLIENT_ALLOWLIST=172\.30\.10\.3[0-9]

MOCK_TARGET_HOSTNAME=shop.brakes-vapt.test
MOCK_TARGET_PUBLISH_PORT=3000

# Generate with: openssl rand -hex 24
ZAP_API_KEY=replace-me-with-a-random-value

# Probes that MUST fail from inside the lab. Changing these weakens I4.
ISOLATION_PROBE_TARGETS=1.1.1.1:443,8.8.8.8:53
ISOLATION_PROBE_DNS_NAME=example.com
ISOLATION_CHECK_TTL_MINUTES=60

# ---- Standing safety gates (M2+; listed here so the posture is explicit) ---
SCANNER_EXECUTION_ENABLED=false
ZAP_ADAPTER_ENABLED=false
ACTIVE_SCAN_ENABLED=false
DUAL_CONTROL_AVAILABLE=false
DEFAULT_SCANNER_ADAPTER=mock

# ---- MVP phase 1: real datastores (vapt_core only, no egress) --------------
POSTGRES_DB=vapt
POSTGRES_USER=vapt
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me-with-a-random-value
REDIS_PASSWORD=replace-me-with-a-random-value
